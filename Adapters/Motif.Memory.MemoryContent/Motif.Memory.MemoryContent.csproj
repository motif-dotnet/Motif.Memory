<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\Motif.Memory\Motif.Memory.UseCases\Motif.Memory.UseCases.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Motif.Memory.Adapters</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Every file of Content/, dot-files too, named by its path there. -->
    <EmbeddedResource Include="..\..\Content\**\*" LogicalName="Content/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
